// Rows of 32-bit words between two pitched planes, bit for bit: VapourSynth
// GPU frame planes whose rows are not tight (stride above the row) to and
// from the planes the kernels read and write (runtime/gpu_frames.hpp). Tight
// planes are copied with vkCmdCopyBuffer instead: copy engines charge per
// region, so a copy of padded rows would take one region a row.
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64, local_size_y = 4) in;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Source { uint v[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer Target { uint v[]; };

layout(push_constant) uniform Push {
    Source src;
    Target dst;
    uint width;      // words a row
    uint height;
    uint src_pitch;  // words
    uint dst_pitch;  // words
} pc;

void main() {
    const uint x = gl_GlobalInvocationID.x;
    const uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height) return;
    pc.dst.v[y * pc.dst_pitch + x] = pc.src.v[y * pc.src_pitch + x];
}
