// SPDX-License-Identifier: GPL-2.0-only
// WNNM, groups of up to 8 patches, kernel 2 of 3 (wnnm/gram8.glsl): one
// invocation a group, the Gram matrix to M = V diag(gain) V^T and the weight,
// as nss_cuda's gram_solve_kernel with jacobi_eigen<8> (gram_shrink.cuh) and
// WnnmModel::finish without codes. The sweep's pairs are unrolled, so that g
// and v stay in registers (a run-time index would put them in Function
// storage, the analogue of local memory).
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_EXT_control_flow_attributes : require
#extension GL_GOOGLE_include_directive : require

#include "wnnm/gram8.glsl"

layout(local_size_x = kChunk) in;

// One Jacobi rotation of the symmetric g in the (p, q) plane, also applied to
// the columns of v; without an off-diagonal element the identity.
#define JACOBI_ROTATE(P, Q)                                                                         \
    {                                                                                               \
        const float apq = g[(P) * kN + (Q)];                                                        \
        const bool rotate = apq != 0.0f;                                                            \
        const float theta = (g[(Q) * kN + (Q)] - g[(P) * kN + (P)]) / (2.0f * (rotate ? apq : 1.0f)); \
        const float t = (theta < 0.0f ? -1.0f : 1.0f) / (abs(theta) + sqrt(fma(theta, theta, 1.0f)));    \
        const float c = rotate ? inversesqrt(fma(t, t, 1.0f)) : 1.0f;                                \
        const float sn = rotate ? t * c : 0.0f;                                                     \
        [[unroll]] for (int k = 0; k < kN; ++k) {                                                   \
            const float gkp = g[k * kN + (P)], gkq = g[k * kN + (Q)];                               \
            g[k * kN + (P)] = c * gkp - sn * gkq;                                                   \
            g[k * kN + (Q)] = sn * gkp + c * gkq;                                                   \
        }                                                                                           \
        [[unroll]] for (int k = 0; k < kN; ++k) {                                                   \
            const float gpk = g[(P) * kN + k], gqk = g[(Q) * kN + k];                               \
            g[(P) * kN + k] = c * gpk - sn * gqk;                                                   \
            g[(Q) * kN + k] = sn * gpk + c * gqk;                                                   \
        }                                                                                           \
        [[unroll]] for (int k = 0; k < kN; ++k) {                                                   \
            const float vkp = v[k * kN + (P)], vkq = v[k * kN + (Q)];                               \
            v[k * kN + (P)] = c * vkp - sn * vkq;                                                   \
            v[k * kN + (Q)] = sn * vkp + c * vkq;                                                   \
        }                                                                                           \
    }

void main() {
    const int r = int((gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * uint(kChunk) + gl_LocalInvocationID.x);
    if (r >= pc.batch) return;  // no barriers below
    const int n = min(Counts(pc.counts).c[r], pc.group);
    const uint64_t at = split_at(r);
    const int width = split_width(r);
    float g[kN * kN], v[kN * kN];
    [[unroll]] for (int j = 0; j < kN; ++j) {
        [[unroll]] for (int k = 0; k <= j; ++k) {
            const float value = Scratch(at).v[(j * (j + 1) / 2 + k) * width];
            g[j * kN + k] = value;
            g[k * kN + j] = value;
        }
    }
    [[unroll]] for (int i = 0; i < kN * kN; ++i) v[i] = (i / kN == i % kN) ? 1.0f : 0.0f;
    // Cyclic sweeps until the off-diagonal part is negligible.
    for (int sweep = 0; sweep < 16; ++sweep) {
        float off = 0.0f, diag = 0.0f;
        [[unroll]] for (int i = 0; i < kN; ++i) {
            diag = fma(g[i * kN + i], g[i * kN + i], diag);
            [[unroll]] for (int j = i + 1; j < kN; ++j) off = fma(g[i * kN + j], g[i * kN + j], off);
        }
        if (off <= 1e-13f * diag || off <= 1e-30f) break;
        [[unroll]] for (int p = 0; p < kN - 1; ++p) {
            [[unroll]] for (int q = p + 1; q < kN; ++q) JACOBI_ROTATE(p, q)
        }
    }
    // The finish: value j's place in the descending order (equal values by
    // index), its gain, then M = V diag(gain) V^T.
    const int area = pc.block * pc.block;
    const int rank = min(area, n), start = min(wnnm_center() ? 0 : 1, rank);
    const float constant = wnnm_constant(n);
    float s[kN], gain[kN];
    [[unroll]] for (int j = 0; j < kN; ++j) {
        const float lambda = g[j * kN + j];
        s[j] = lambda > 0.0f ? sqrt(lambda) : 0.0f;
    }
    int kept = 0;
    [[unroll]] for (int j = 0; j < kN; ++j) {
        int place = 0;
        [[unroll]] for (int i = 0; i < kN; ++i) place += (s[i] > s[j] || (s[i] == s[j] && i < j)) ? 1 : 0;
        bool keep;
        gain[j] = wnnm_gain(s[j], place, start, rank, constant, keep);
        kept += keep ? 1 : 0;
    }
    [[unroll]] for (int i = 0; i < kN; ++i) {
        [[unroll]] for (int j = 0; j < kN; ++j) {
            float sum = 0.0f;
            [[unroll]] for (int k = 0; k < kN; ++k) sum = fma(v[i * kN + k] * gain[k], v[j * kN + k], sum);
            Scratch(at).v[(kSplitGram + i * kN + j) * width] = sum;
        }
    }
    Scratch(at).v[(kSplitGram + kN * kN) * width] = wnnm_weight(kept);
}
